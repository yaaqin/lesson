# Contoh .env buat deploy pakai docker-compose.yml di VPS. Salin ke .env di
# folder ini (sejajar sama Dockerfile), lalu `docker compose up -d --build`.
#
# Nilai ini di-inline ke bundle pas build, jadi setiap kali diubah wajib
# build ulang (`--build`). Jangan lupa domain web ini juga harus masuk ke
# ALLOWED_ORIGINS + WEB_APP_URL di .env services/api.
NEXT_PUBLIC_API_BASE_URL=https://lesson-api.yaaqin.xyz/api/v1
