# Contoh .env buat deploy pakai docker-compose.yml di VPS. Salin ke .env di
# folder ini (sejajar sama Dockerfile), isi nilai aslinya, JANGAN di-commit.
#
# DOMAIN dipakai Caddy buat HTTPS otomatis (Let's Encrypt) -- pastikan DNS A
# record domain ini udah ngarah ke IP VPS-nya SEBELUM `docker compose up`,
# dan port 80/443 kebuka di firewall (Caddy butuh 80 buat verifikasi ACME).
DOMAIN=api.namadomainkamu.com

PORT=9801
DATABASE_URL=postgres://lesson_app:GANTI_PASSWORD@HOST_DB:5432/lesson?sslmode=disable

# WAJIB diganti -- random string panjang, jangan pakai nilai dev.
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Origin frontend yang boleh akses API (CORS) -- cuma ngaruh ke request dari
# browser (dashboard/userApp web). Aplikasi Android native gak kena CORS sama
# sekali, jadi baris ini gak wajib diubah biar Android bisa connect.
ALLOWED_ORIGINS=https://dashboard.namadomainkamu.com,https://app.namadomainkamu.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.namadomainkamu.com/api/v1/auth/google/callback

WEB_APP_URL=https://app.namadomainkamu.com
