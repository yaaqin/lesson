PORT=9801
DATABASE_URL=postgres://lesson:lesson@localhost:9800/lesson?sslmode=disable

# Ganti dengan random string yang panjang & rahasia di production.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Origin frontend yang boleh akses API (CORS), pisah dengan koma.
ALLOWED_ORIGINS=http://localhost:9802,http://localhost:9803

# Google OAuth — ambil dari Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:9801/api/v1/auth/google/callback

# Dipakai buat redirect balik setelah login Google berhasil/gagal.
WEB_APP_URL=http://localhost:9803

# Dipakai cmd/seed (opsional, ada default kalau tidak diisi).
SEED_ADMIN_EMAIL=admin@mathquest.dev
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Admin Platform
