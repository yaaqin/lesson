# Server block nginx buat proxy domain lesson-api.yaaqin.xyz ke container api
# (bind ke 127.0.0.1:9801 lewat docker-compose.yml). Taruh sebagai file baru
# di /etc/nginx/sites-available/lesson-api.yaaqin.xyz, lalu:
#
#   sudo ln -s /etc/nginx/sites-available/lesson-api.yaaqin.xyz /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d lesson-api.yaaqin.xyz   # otomatis nambahin blok HTTPS + redirect
#
# Pastikan DNS A record lesson-api.yaaqin.xyz udah ngarah ke IP VPS ini
# sebelum jalanin certbot (verifikasi ACME butuh domain udah resolve).

server {
    listen 80;
    server_name lesson-api.yaaqin.xyz;

    location / {
        proxy_pass http://127.0.0.1:9801;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket (multiplayer, GET /api/v1/app/multiplayer/ws). Timeout
        # dipanjangin biar koneksi yang nunggu di lobby gak diputus nginx
        # (server juga ngirim ping tiap 25 detik).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
