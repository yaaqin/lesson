# Contoh server block nginx buat proxy ke container api (bind ke
# 127.0.0.1:9801 lewat docker-compose.yml). Taruh sebagai file baru di
# /etc/nginx/sites-available/api.namadomainkamu.com, lalu:
#
#   sudo ln -s /etc/nginx/sites-available/api.namadomainkamu.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.namadomainkamu.com   # otomatis nambahin blok HTTPS + redirect
#
# Pastikan DNS A record domain ini udah ngarah ke IP VPS sebelum certbot.

server {
    listen 80;
    server_name api.namadomainkamu.com;

    location / {
        proxy_pass http://127.0.0.1:9801;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
